
@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="d-flex justify-content-center  bg-light" style="min-height: 30vh;padding-top: 100px;">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 400px; width:   100%;">
        <h2 class="text-center mb-4 fw-bold">Log in</h2>

        <form id="account" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Email -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="current-password" aria-required="true" placeholder="password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
                <div class="mt-2">
                    <a id="forgot-password" asp-page="./ForgotPassword" class="text-decoration-none small">Forgot password?</a>
                </div>
            </div>

            <!-- Remember Me -->
            <div class="form-check mb-3">
                <input class="form-check-input" asp-for="Input.RememberMe" />
                <label asp-for="Input.RememberMe" class="form-check-label">
                    @Html.DisplayNameFor(m => m.Input.RememberMe)
                </label>
            </div>

            <!-- Submit -->
            <button id="login-submit" type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Log in</button>

            <!-- Register -->
            <p class="text-center mt-3 mb-0">
                Don’t have an account?
                <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Register</a>
            </p>
        </form>

        <hr class="my-4">

        <!-- External Login -->
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="d-grid gap-2">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        string iconClass = provider.Name switch
                        {
                            "Google" => "fab fa-google",
                            "Facebook" => "fab fa-facebook",
                            "Microsoft" => "fab fa-microsoft",
                            _ => "fas fa-sign-in-alt"
                        };

                        string btnClass = provider.Name switch
                        {
                            "Google" => "btn-danger",   // red
                            "Facebook" => "btn-primary",  // blue
                            "Microsoft" => "btn-dark",     // dark gray
                            _ => "btn-secondary"
                        };

                        <button type="submit"
                                class="btn @btnClass d-flex justify-content-center align-items-center mb-2"
                                name="provider" value="@provider.Name">
                            <i class="@iconClass me-2"></i>
                            Log in with @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        }
        else
        {
            <p class="text-muted small">
                No external authentication services configured.
                <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">Learn more</a>.
            </p>
        }
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}



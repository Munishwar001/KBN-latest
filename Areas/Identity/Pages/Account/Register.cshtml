@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<div class="d-flex justify-content-center  bg-light" style="min-height: 30vh;padding-top: 100px;">
    <div class="card shadow-lg p-4 rounded-4" style="max-width: 420px; width: 100%;">
        <h2 class="text-center mb-4 fw-bold">Register </h2>

        <!-- Register Form -->
        <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>

            <!-- Name -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Name" class="form-control" autocomplete="name" aria-required="true" placeholder="John Doe" />
                <label asp-for="Input.Name">Name</label>
                <span asp-validation-for="Input.Name" class="text-danger small"></span>
            </div>

            <!-- Email -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Email" class="form-control" autocomplete="username" aria-required="true" placeholder="name@example.com" />
                <label asp-for="Input.Email">Email</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>

            <!-- Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.Password" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Password" />
                <label asp-for="Input.Password">Password</label>
                <span asp-validation-for="Input.Password" class="text-danger small"></span>
            </div>

            <!-- Confirm Password -->
            <div class="form-floating mb-3">
                <input asp-for="Input.ConfirmPassword" class="form-control" autocomplete="new-password" aria-required="true" placeholder="Confirm Password" />
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger small"></span>
            </div>

            <!-- Submit -->
            <button id="registerSubmit" type="submit" class="btn btn-primary w-100 py-2 fw-semibold">Register</button>
        </form>

        <!-- External Providers -->
        <hr class="my-4" />
        @if ((Model.ExternalLogins?.Count ?? 0) > 0)
        {
            <form id="external-account" asp-page="./ExternalLogin" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                <div class="d-grid gap-2">
                    @foreach (var provider in Model.ExternalLogins!)
                    {
                        string iconClass = provider.Name switch
                        {
                            "Google" => "fab fa-google",
                            "Facebook" => "fab fa-facebook",
                            "Microsoft" => "fab fa-microsoft",
                            _ => "fas fa-sign-in-alt"
                        };

                        string btnClass = provider.Name switch
                        {
                            "Google" => "btn-danger",   
                            "Facebook" => "btn-primary",  
                            "Microsoft" => "btn-dark",     
                            _ => "btn-secondary"
                        };

                        <button type="submit"
                                class="btn @btnClass d-flex justify-content-center align-items-center mb-2"
                                name="provider" value="@provider.Name">
                            <i class="@iconClass me-2"></i>
                            Log in with @provider.DisplayName
                        </button>
                    }
                </div>
            </form>
        }
        else
        {
            <p class="text-muted small text-center">
                No external authentication services configured. 
                <a href="https://go.microsoft.com/fwlink/?LinkID=532715" target="_blank">Learn more</a>.
            </p>
        }

        <!-- Already have account -->
        <p class="text-center mt-3 mb-0">
            Already have an account? 
            <a asp-page="./Login" asp-route-returnUrl="@Model.ReturnUrl" class="text-decoration-none fw-semibold">Log in</a>
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

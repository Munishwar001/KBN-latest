@model KBN.Models.SubscriberModels.SubscriberViewModel;
@{
    ViewData["Title"] = "GetData subscribers";
}
@Html.Hidden("resultCount", Model.count)

<div class="table-container">
    <table>
        <thead>
            <tr>
                @* <th></th> *@
                <th>CustomerName</th>
                <th>User Name</th>
                <th>Manage</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model.subscriberList)
            {
                <tr class="getTableRow">
                    <td>@(string.IsNullOrEmpty(item.customer_name) ? "---" : item.customer_name)</td>
                    <td>@item.username</td>
                    <td>
                        <button class="btn btn-sm btn-success updateSubBtn" data-id="@item.id">
                            <i class="fa fa-pencil-alt" id="updateSubDID"></i>
                        </button>
                        <button class="btn btn-sm btn-danger deleteSubBtn" data-id="@item.id">
                            <i class="fa fa-trash"></i>
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
<div id="paginate"></div>

<style>
    /* Table wrapper */
    table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 1.5rem;
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 12px rgba(0, 0, 0, 0.05);
    }

        /* Table header */
        table thead {
            background: #0d6efd; /* Bootstrap blue */
            color: #fff;
            text-align: left;
            font-weight: 600;
        }

            table thead th {
                padding: 12px 16px;
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 0.5px;
            }

        /* Table rows */
        table tbody tr {
            border-bottom: 1px solid #f0f0f0;
            transition: background 0.2s ease-in-out;
        }

            table tbody tr:hover {
                background: #f8f9fa; /* Light gray hover */
            }

        /* Table cells */
        table td {
            padding: 12px 16px;
            font-size: 14px;
            color: #333;
            vertical-align: middle;
        }

            /* Base icon style */
            table td i {
                cursor: pointer;
                font-size: 14px;
                margin: 0 4px;
                padding: 6px;
                border-radius: 6px;
                color: #fff; /* white icon */
                display: inline-block;
                transition: transform 0.2s ease;
            }

                /* Edit icon (blue background) */
                table td i.fa-pencil-alt {
                    background: #008000; /* Bootstrap blue */
                }

                /* Delete icon (red background) */
                table td i.fa-trash {
                    background: #dc3545; /* Bootstrap danger red */
                }

                /* Subtle hover animation */
                table td i:hover {
                    transform: scale(1.2);
                }

    /* Table container with vertical + horizontal scroll */
    .table-container {
        width: 100%;
        max-height: 800px; /* adjust height according to your need */
        overflow-y: auto; /* vertical scroll */
        overflow-x: auto; /* horizontal scroll */
        border-radius: 12px;
        padding: 0%;
    }

    /* Keep table wide */
    table {
        min-width: 600px;
        width: 100%;
        border-collapse: collapse;
        background: #fff;
    }

 
    .getTableRow:hover {
        background: rgb(230, 230, 231);
        color: #fff;
        z-index: 2;
        padding: 12px 16px;
    }
</style>
